+// validateIncomingFollowUndo is a probe-scoped guard for Undo of a stored Follow.
+// Other stored activity types retain the previous unsupported dispatch behavior.
+func (p P) validateIncomingFollowUndo(it vocab.Item, author vocab.Actor) error {
+	return vocab.OnActivity(it, func(undo *vocab.Activity) error {
+		if vocab.IsNil(undo.Object) || undo.Object.GetID() == "" {
+			return errors.BadRequestf("missing original activity")
+		}
+		// Embedded non-Follow Undo stays on the existing unsupported path.
+		if !vocab.IsIRI(undo.Object) && !vocab.FollowType.Match(undo.Object.GetType()) {
+			return nil
+		}
+		stored, err := p.s.Load(undo.Object.GetID())
+		if err != nil || vocab.IsNil(stored) {
+			return errors.BadRequestf("original activity is not cached")
+		}
+		if !vocab.FollowType.Match(stored.GetType()) {
+			if vocab.FollowType.Match(undo.Object.GetType()) {
+				return errors.BadRequestf("original is not a Follow")
+			}
+			return nil
+		}
+		return vocab.OnActivity(stored, func(follow *vocab.Activity) error {
+			if vocab.IsNil(undo.Actor) || vocab.IsNil(follow.Actor) || !undo.Actor.GetID().Equal(author.ID) || !follow.Actor.GetID().Equal(author.ID) {
+				return errors.BadRequestf("Undo actor does not own stored Follow")
+			}
+			if !vocab.IsIRI(undo.Object) {
+				if !vocab.FollowType.Match(undo.Object.GetType()) {
+					return errors.BadRequestf("embedded original type differs")
+				}
+				if err := vocab.OnActivity(undo.Object, func(supplied *vocab.Activity) error {
+					if vocab.IsNil(supplied.Actor) || !supplied.Actor.GetID().Equal(follow.Actor.GetID()) {
+						return errors.BadRequestf("embedded original actor differs")
+					}
+					return nil
+				}); err != nil {
+					return err
+				}
+			}
+			undo.Object = follow
+			return p.ValidateClientNegatingActivity(undo)
+		})
+	})
+}
