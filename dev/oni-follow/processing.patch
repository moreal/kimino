+package processing
+
+import (
+	"bytes"
+	"encoding/json"
+	vocab "github.com/go-ap/activitypub"
+	"strings"
+	"testing"
+)
+
+func TestKiminoDeliveryAudit(t *testing.T) {
+	activity := &vocab.Activity{ID: "https://private.example/activity/1", Type: vocab.CreateType, Object: &vocab.Object{ID: "https://private.example/note/1", Type: vocab.NoteType, Content: vocab.DefaultNaturalLanguage("private draft must never be logged")}}
+	var output bytes.Buffer
+	audit := newProbeDeliveryAudit(activity, &output)
+	audit.remoteTargets = 0
+	audit.finish()
+	var value map[string]any
+	if err := json.Unmarshal(bytes.TrimPrefix(output.Bytes(), []byte("KIMINO_DELIVERY_AUDIT ")), &value); err != nil {
+		t.Fatal(err)
+	}
+	if value["completed"] != false {
+		t.Fatal("unfinished dispatch must not be successful")
+	}
+	if strings.Contains(output.String(), "private") || strings.Contains(output.String(), "https:") {
+		t.Fatal("audit leaked source information")
+	}
+	if len(value["activity_hash"].(string)) != 64 || len(value["object_hash"].(string)) != 64 {
+		t.Fatal("missing correlation hashes")
+	}
+	output.Reset()
+	audit.completed = true
+	audit.remoteTargets = 1
+	audit.remoteFailed = true
+	audit.finish()
+	if err := json.Unmarshal(bytes.TrimPrefix(output.Bytes(), []byte("KIMINO_DELIVERY_AUDIT ")), &value); err != nil {
+		t.Fatal(err)
+	}
+	if value["completed"] != true || value["remote_targets"] != float64(1) || value["remote_failed"] != true {
+		t.Fatal("terminal evidence lost")
+	}
+}
+func TestKiminoDeliveryAuditDisabled(t *testing.T) {
+	t.Setenv("KIMINO_DELIVERY_AUDIT", "")
+	if startProbeDeliveryAudit(&vocab.Activity{ID: "https://example.test/activity"}) != nil {
+		t.Fatal("audit must be opt in")
+	}
+}
