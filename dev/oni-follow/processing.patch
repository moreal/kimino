+
+func probeActor(id v.IRI) *v.Actor {
+	return &v.Actor{ID: id, Type: v.ApplicationType, Inbox: v.Inbox.Of(id), Outbox: v.Outbox.Of(id), Followers: v.Followers.Of(id), Following: v.Following.Of(id)}
+}
+func TestKiminoLocalFollowersExpansion(t *testing.T) {
+	for _, iriMember := range []bool{false, true} {
+		t.Run(map[bool]string{false: "embedded", true: "IRI"}[iriMember], func(t *testing.T) {
+			st := mockStore{&sync.Map{}}
+			bob := probeActor("https://bob.test/")
+			alice := probeActor("https://alice.test/")
+			blocked := probeActor("https://blocked.test/")
+			shared := probeActor("https://shared.test/")
+			shared.Endpoints = &v.Endpoints{SharedInbox: v.IRI("https://shared.test/shared-inbox")}
+			for _, a := range []*v.Actor{bob, alice, blocked, shared} {
+				st.Save(a)
+			}
+			members := v.ItemCollection{alice, blocked, bob, shared}
+			if iriMember {
+				members = v.ItemCollection{alice.ID, blocked.ID, bob.ID, shared.ID}
+			}
+			st.Save(&v.OrderedCollection{ID: v.Followers.IRI(bob), Type: v.OrderedCollectionType, OrderedItems: members})
+			st.Save(&v.OrderedCollection{ID: BlockedCollection.IRI(bob), Type: v.OrderedCollectionType, OrderedItems: v.ItemCollection{blocked.ID}})
+			p := New(WithStorage(st), WithIRI(bob.ID))
+			act := &v.Activity{ID: "https://bob.test/outbox/note", Type: v.CreateType, Actor: bob, To: v.ItemCollection{v.PublicNS}, CC: v.ItemCollection{v.Followers.IRI(bob)}, Object: &v.Object{Type: v.NoteType}}
+			got := p.BuildOutboxRecipientsList(act, v.Outbox.IRI(bob))
+			if !got.Contains(alice.Inbox) {
+				t.Error("followers actor inbox missing")
+			}
+			if !got.Contains(shared.Endpoints.SharedInbox) {
+				t.Error("public shared inbox missing")
+			}
+			if got.Contains(blocked.Inbox) {
+				t.Error("blocked follower included")
+			}
+			act.To = nil
+			private := p.BuildOutboxRecipientsList(act, v.Outbox.IRI(bob))
+			if private.Contains(bob.Inbox) {
+				t.Error("self follower included")
+			}
+			if !private.Contains(shared.Inbox) {
+				t.Error("nonpublic follower inbox missing")
+			}
+			if private.Contains(shared.Endpoints.SharedInbox) {
+				t.Error("nonpublic shared inbox used")
+			}
+		})
+	}
+}
+
+type probeStore struct {
+	mockStore
+	saves, removes int
+	removed        []v.IRI
+}
+
+func (s *probeStore) Save(x v.Item) (v.Item, error) { s.saves++; return s.mockStore.Save(x) }
+func (s *probeStore) RemoveFrom(c v.IRI, x ...v.Item) error {
+	s.removes++
+	s.removed = append(s.removed, c)
+	it, err := s.Load(c)
+	if err != nil {
+		return err
+	}
+	return v.OnOrderedCollection(it, func(col *v.OrderedCollection) error {
+		kept := make(v.ItemCollection, 0, len(col.OrderedItems))
+		for _, member := range col.OrderedItems {
+			remove := false
+			for _, target := range x {
+				if member.GetID().Equal(target.GetID()) {
+					remove = true
+				}
+			}
+			if !remove {
+				kept = append(kept, member)
+			}
+		}
+		col.OrderedItems = kept
+		return nil
+	})
+}
+func TestKiminoIncomingUndoKnownFollow(t *testing.T) {
+	for _, kind := range []string{"valid", "valid_iri", "wrong_authenticated_actor", "spoofed_embedded_actor", "missing_original", "wrong_original_type", "unsupported_like", "unsupported_like_missing"} {
+		t.Run(kind, func(t *testing.T) {
+			s := &probeStore{mockStore: mockStore{&sync.Map{}}}
+			bob := probeActor("https://bob.test/")
+			alice := probeActor("https://alice.test/")
+			mallory := probeActor("https://mallory.test/")
+			for _, a := range []*v.Actor{bob, alice, mallory} {
+				s.mockStore.Save(a)
+			}
+			followers := &v.OrderedCollection{ID: v.Followers.IRI(bob), Type: v.OrderedCollectionType, OrderedItems: v.ItemCollection{alice}}
+			s.mockStore.Save(followers)
+			s.mockStore.Save(&v.OrderedCollection{ID: v.Inbox.IRI(bob), Type: v.OrderedCollectionType})
+			original := &v.Activity{ID: "https://alice.test/outbox/follow", Type: v.FollowType, Actor: alice, Object: bob, To: v.ItemCollection{bob.ID}}
+			if kind == "wrong_original_type" || kind == "unsupported_like" || kind == "unsupported_like_missing" {
+				original.Type = v.LikeType
+			}
+			if kind != "missing_original" && kind != "unsupported_like_missing" {
+				s.mockStore.Save(original)
+			}
+			embedded := *original
+			if kind == "wrong_original_type" {
+				embedded.Type = v.FollowType
+			}
+			author := *alice
+			undoActor := v.Item(alice)
+			if kind == "wrong_authenticated_actor" {
+				author = *mallory
+				undoActor = mallory
+			}
+			if kind == "spoofed_embedded_actor" {
+				embedded.Actor = mallory
+				author = *mallory
+				undoActor = mallory
+			}
+			var object v.Item = &embedded
+			if kind == "valid_iri" {
+				object = original.ID
+			}
+			undo := &v.Activity{ID: "https://alice.test/outbox/undo", Type: v.UndoType, Actor: undoActor, Object: object, To: v.ItemCollection{bob.ID}}
+			p := New(WithStorage(s), WithIRI(bob.ID))
+			_, err := p.ProcessServerActivity(undo, author, v.Inbox.IRI(bob))
+			if kind == "unsupported_like" || kind == "unsupported_like_missing" {
+				if err != nil || s.removes != 0 || !followers.Contains(alice) {
+					t.Fatal("unsupported Undo behavior changed")
+				}
+				return
+			}
+			if kind == "valid" || kind == "valid_iri" {
+				if err != nil {
+					t.Fatal(err)
+				}
+				if followers.Contains(alice) {
+					t.Errorf("incoming Undo did not remove follower; removes=%d saves=%d objectType=%s cols=%v", s.removes, s.saves, undo.Object.GetType(), s.removed)
+				}
+			} else {
+				if err == nil {
+					t.Error("invalid incoming Undo accepted")
+				}
+				if s.saves != 0 || s.removes != 0 {
+					t.Errorf("mutation before rejection: saves=%d removes=%d", s.saves, s.removes)
+				}
+				if !followers.Contains(alice) {
+					t.Error("invalid Undo removed follower")
+				}
+			}
+		})
+	}
+}
