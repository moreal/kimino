+package processing
+
+import (
+	"context"
+	"fmt"
+	v "github.com/go-ap/activitypub"
+	"sync"
+	"testing"
+)
+
+type withdrawalCall struct {
+	target v.IRI
+	item   v.Item
+}
+type withdrawalTransport struct {
+	store    ReadStore
+	mu       sync.Mutex
+	calls    []withdrawalCall
+	failures int
+}
+
+func (c *withdrawalTransport) LoadIRI(i v.IRI) (v.Item, error) { return c.store.Load(i) }
+func (c *withdrawalTransport) CtxLoadIRI(_ context.Context, i v.IRI) (v.Item, error) {
+	return c.LoadIRI(i)
+}
+func (c *withdrawalTransport) ToCollection(i v.Item, to ...v.IRI) (v.IRI, v.Item, error) {
+	return c.CtxToCollection(context.Background(), i, to...)
+}
+func (c *withdrawalTransport) CtxToCollection(_ context.Context, i v.Item, to ...v.IRI) (v.IRI, v.Item, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	data, err := v.MarshalJSON(i)
+	if err != nil {
+		c.failures++
+		return "", nil, err
+	}
+	copy, err := v.UnmarshalJSON(data)
+	if err != nil {
+		c.failures++
+		return "", nil, err
+	}
+	for _, target := range to {
+		c.calls = append(c.calls, withdrawalCall{target, copy})
+	}
+	return i.GetLink(), copy, nil
+}
+func (c *withdrawalTransport) matching(id, target v.IRI) []v.Item {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	var out []v.Item
+	for _, call := range c.calls {
+		if call.target == target && call.item.GetLink() == id {
+			out = append(out, call.item)
+		}
+	}
+	return out
+}
+
+func TestKiminoSynchronousFollowWithdrawalDelivery(t *testing.T) {
+	alice, bob := probeActor("https://alice.test/"), probeActor("https://bob.test/")
+	setup := func(owner *v.Actor) (*P, *probeStore, *withdrawalTransport) {
+		s := &probeStore{mockStore: mockStore{&sync.Map{}}}
+		for _, a := range []*v.Actor{alice, bob} {
+			s.Save(a)
+		}
+		for _, path := range []v.CollectionPath{v.Inbox, v.Outbox, v.Followers, v.Following} {
+			s.Save(&v.OrderedCollection{ID: path.IRI(owner), Type: v.OrderedCollectionType})
+		}
+		c := &withdrawalTransport{store: s}
+		p := New(WithStorage(s), WithIRI(owner.ID), WithClient(c), WithDisseminationRetryCount(0))
+		if p.async {
+			t.Fatal("completion assertions require synchronous processing")
+		}
+		return p, s, c
+	}
+	pa, sa, ca := setup(alice)
+	pb, sb, cb := setup(bob)
+	submit := func(p *P, owner *v.Actor, a *v.Activity) {
+		t.Helper()
+		if _, err := p.ProcessClientActivity(a, *owner, v.Outbox.IRI(owner)); err != nil {
+			t.Fatalf("client %s failed: %v", a.Type, err)
+		}
+	}
+	receive := func(c *withdrawalTransport, p *P, author, owner *v.Actor, id v.IRI) {
+		t.Helper()
+		calls := c.matching(id, v.Inbox.IRI(owner))
+		if len(calls) != 1 {
+			t.Fatalf("delivery count=%d want=1", len(calls))
+		}
+		if _, err := p.ProcessServerActivity(calls[0], *author, v.Inbox.IRI(owner)); err != nil {
+			t.Fatalf("server processing failed: %v", err)
+		}
+	}
+	member := func(s *probeStore, col v.IRI, item v.IRI) bool {
+		t.Helper()
+		got, err := s.Load(col)
+		if err != nil {
+			t.Fatal(err)
+		}
+		found := false
+		if err := v.OnCollectionIntf(got, func(c v.CollectionInterface) error {
+			for _, member := range c.Collection() {
+				if member.GetLink().Equal(item) {
+					found = true
+				}
+			}
+			return nil
+		}); err != nil {
+			t.Fatal(err)
+		}
+		return found
+	}
+	follow := &v.Activity{ID: "https://alice.test/activities/follow", Type: v.FollowType, Actor: alice, Object: bob, To: v.ItemCollection{bob.ID}}
+	submit(pa, alice, follow)
+	receive(ca, pb, alice, bob, follow.ID)
+	accept := &v.Activity{ID: "https://bob.test/activities/accept", Type: v.AcceptType, Actor: bob, Object: follow.ID, To: v.ItemCollection{alice.ID}}
+	submit(pb, bob, accept)
+	receive(cb, pa, bob, alice, accept.ID)
+	if !member(sa, v.Following.IRI(alice), bob.ID) || !member(sb, v.Followers.IRI(bob), alice.ID) {
+		t.Fatalf("Accept graph membership following=%t followers=%t", member(sa, v.Following.IRI(alice), bob.ID), member(sb, v.Followers.IRI(bob), alice.ID))
+	}
+	note := func(suffix string) *v.Activity {
+		return &v.Activity{ID: v.ID("https://bob.test/activities/" + suffix), Type: v.CreateType, Actor: bob, To: v.ItemCollection{v.Followers.IRI(bob)}, Object: &v.Object{ID: v.ID("https://bob.test/notes/" + suffix), Type: v.NoteType, AttributedTo: bob.ID, MediaType: "text/html", Content: v.NaturalLanguageValues{v.NilLangRef: v.Content("Synthetic fixture text")}, To: v.ItemCollection{v.Followers.IRI(bob)}}}
+	}
+	before := note("before")
+	submit(pb, bob, before)
+	receive(cb, pa, bob, alice, before.ID)
+	if !member(sa, v.Inbox.IRI(alice), before.ID) {
+		t.Fatal("baseline followers-only text did not reach Alice inbox")
+	}
+	undo := &v.Activity{ID: "https://alice.test/activities/undo", Type: v.UndoType, Actor: alice, Object: follow.ID, To: v.ItemCollection{bob.ID}}
+	submit(pa, alice, undo)
+	receive(ca, pb, alice, bob, undo.ID)
+	// Continue to the second send even if the graph assertion fails, so the
+	// mutation test proves both graph evidence and transport non-delivery.
+	if member(sa, v.Following.IRI(alice), bob.ID) || member(sb, v.Followers.IRI(bob), alice.ID) {
+		t.Error("exact Undo left graph membership")
+	}
+	after := note("after")
+	submit(pb, bob, after)
+	if got := len(cb.matching(after.ID, v.Inbox.IRI(alice))); got != 0 {
+		t.Errorf("completed post-Undo routing called Alice %d times", got)
+	}
+	if !member(sb, v.Outbox.IRI(bob), after.ID) {
+		t.Error("post-Undo activity did not complete local outbox dissemination")
+	}
+	if member(sa, v.Inbox.IRI(alice), after.ID) {
+		t.Error("post-Undo activity appeared in Alice inbox")
+	}
+	if ca.failures+cb.failures != 0 {
+		t.Fatal(fmt.Sprintf("recording transport failures=%d", ca.failures+cb.failures))
+	}
+}
