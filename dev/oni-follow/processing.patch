+func TestKiminoReplayedUndoDoesNotRemoveNewFollow(t *testing.T) {
+	s := &probeStore{mockStore: mockStore{&sync.Map{}}}
+	bob := probeActor("https://bob.test/")
+	alice := probeActor("https://alice.test/")
+	s.mockStore.Save(bob)
+	s.mockStore.Save(alice)
+	followers := &v.OrderedCollection{ID: v.Followers.IRI(bob), Type: v.OrderedCollectionType, OrderedItems: v.ItemCollection{alice}}
+	s.mockStore.Save(followers)
+	s.mockStore.Save(&v.OrderedCollection{ID: v.Inbox.IRI(bob), Type: v.OrderedCollectionType})
+	f1 := &v.Activity{ID: "https://alice.test/outbox/f1", Type: v.FollowType, Actor: alice, Object: bob, To: v.ItemCollection{bob.ID}}
+	s.mockStore.Save(f1)
+	p := New(WithStorage(s), WithIRI(bob.ID))
+	u1 := &v.Activity{ID: "https://alice.test/outbox/u1", Type: v.UndoType, Actor: alice, Object: f1, To: v.ItemCollection{bob.ID}}
+	if _, err := p.ProcessServerActivity(u1, *alice, v.Inbox.IRI(bob)); err != nil {
+		t.Fatal(err)
+	}
+	if followers.Contains(alice) {
+		t.Fatal("first Undo failed")
+	}
+	f2 := &v.Activity{ID: "https://alice.test/outbox/f2", Type: v.FollowType, Actor: alice, Object: bob, To: v.ItemCollection{bob.ID}}
+	s.mockStore.Save(f2)
+	if _, err := AcceptActivity(p, &v.Activity{Type: v.AcceptType, Actor: bob, Object: f2}, v.Outbox.IRI(bob)); err != nil {
+		t.Fatal(err)
+	}
+	if !followers.Contains(alice) {
+		t.Fatal("second Follow was not accepted")
+	}
+	before := s.removes
+	replay := &v.Activity{ID: u1.ID, Type: v.UndoType, Actor: alice, Object: f1.ID, To: v.ItemCollection{bob.ID}}
+	if _, err := p.ProcessServerActivity(replay, *alice, v.Inbox.IRI(bob)); err != nil {
+		t.Fatal(err)
+	}
+	if !followers.Contains(alice) || s.removes != before {
+		t.Fatal("replayed old Undo removed new Follow membership")
+	}
+}
