+// Local fixture diagnostics only. Never emit source IRIs, content or errors.
+var probeDeliveryOutput sync.Mutex
+
+type probeDeliveryAudit struct {
+	output                               io.Writer
+	activityHash, objectHash             string
+	remoteTargets                        int
+	localFailed, remoteFailed, completed bool
+}
+
+func newProbeDeliveryAudit(it vocab.Item, output io.Writer) *probeDeliveryAudit {
+	hash := func(iri vocab.IRI) string { sum := sha256.Sum256([]byte(iri)); return hex.EncodeToString(sum[:]) }
+	a := &probeDeliveryAudit{output: output}
+	if !vocab.IsNil(it) {
+		a.activityHash = hash(it.GetLink())
+		_ = vocab.OnActivity(it, func(act *vocab.Activity) error {
+			if !vocab.IsNil(act.Object) {
+				a.objectHash = hash(act.Object.GetLink())
+			}
+			return nil
+		})
+	}
+	return a
+}
+func startProbeDeliveryAudit(it vocab.Item) *probeDeliveryAudit {
+	if os.Getenv("KIMINO_DELIVERY_AUDIT") != "1" {
+		return nil
+	}
+	return newProbeDeliveryAudit(it, os.Stderr)
+}
+func (a *probeDeliveryAudit) finish() {
+	if a == nil {
+		return
+	}
+	record := struct {
+		ActivityHash  string `json:"activity_hash"`
+		ObjectHash    string `json:"object_hash"`
+		RemoteTargets int    `json:"remote_targets"`
+		LocalFailed   bool   `json:"local_failed"`
+		RemoteFailed  bool   `json:"remote_failed"`
+		Completed     bool   `json:"completed"`
+	}{a.activityHash, a.objectHash, a.remoteTargets, a.localFailed, a.remoteFailed, a.completed}
+	data, err := json.Marshal(record)
+	if err != nil {
+		return
+	}
+	probeDeliveryOutput.Lock()
+	defer probeDeliveryOutput.Unlock()
+	_, _ = a.output.Write(append(append([]byte("KIMINO_DELIVERY_AUDIT "), data...), '\n'))
+}
