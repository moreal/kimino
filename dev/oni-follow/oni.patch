+func TestOwnCollectionRequestIdentity(t *testing.T) {
+	const own vocab.IRI = "https://alice.test:18448/inbox"
+	for _, tc := range []struct {
+		name                string
+		collection, request vocab.IRI
+		want                bool
+	}{
+		{"bare", own, own, true},
+		{"first", own, own + "?maxItems=20", true},
+		{"after", own, own + "?maxItems=20&after=https%3A%2F%2Fexample.test%2Fitem", true},
+		{"before_and_filter", own, own + "?before=x&type=Create", true},
+		{"different_actor", "https://bob.test:18448/inbox", own + "?maxItems=20", false},
+		{"different_scheme", own, "http://alice.test:18448/inbox?maxItems=20", false},
+		{"different_port", own, "https://alice.test:18449/inbox?maxItems=20", false},
+		{"different_path", own, "https://alice.test:18448/outbox?maxItems=20", false},
+		{"path_case", own, "https://alice.test:18448/Inbox", false},
+		{"path_dot", own, "https://alice.test:18448/x/../inbox", false},
+		{"path_encoding", own, "https://alice.test:18448/%69nbox", false},
+		{"userinfo", own, "https://other@alice.test:18448/inbox", false},
+		{"fragment", own, own + "#different", false},
+		{"anonymous", "", own, false},
+		{"both_empty", "", "", false},
+		{"relative", "/inbox", "/inbox?maxItems=20", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := isOwnCollectionRequest(tc.collection, tc.request); got != tc.want {
+				t.Fatalf("ownership=%t want=%t", got, tc.want)
+			}
+		})
+	}
+}
