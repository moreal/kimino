+package oni
+
+import (
+	v "github.com/go-ap/activitypub"
+	"net/http"
+	"os"
+)
+
+const privateMediaCapabilityID v.IRI = "urn:kimino:oni:private-media:1"
+
+// This is an explicit experimental server assertion, not a standard ActivityPub
+// feature or an attestation. Only the exact configured root response advertises it.
+func privateMediaActorResponse(item v.Item, r *http.Request) v.Item {
+	if os.Getenv("KIMINO_PRIVATE_MEDIA_CAPABILITY") != "1" || v.IsNil(item) || !v.ActorTypes.Match(item.GetType()) {
+		return item
+	}
+	owner := v.IRI(os.Getenv("ONI_PROBE_LOCAL_ACTOR"))
+	root, valid := exactResourceURL(owner)
+	if !valid || root.Scheme != "https" || root.Path != "/" || item.GetID() != owner {
+		return item
+	}
+	if r.URL.RawQuery != "" || r.URL.ForceQuery || r.URL.Fragment != "" || v.IRI("https://"+r.Host+r.URL.EscapedPath()) != owner {
+		return item
+	}
+	actor, err := v.ToActor(item)
+	if err != nil || actor == nil {
+		return item
+	}
+	copy := *actor
+	generators := make(v.ItemCollection, 0)
+	if !v.IsNil(actor.Generator) {
+		if v.IsItemCollection(actor.Generator) {
+			_ = v.OnItemCollection(actor.Generator, func(items *v.ItemCollection) error { generators = append(generators, (*items)...); return nil })
+		} else {
+			generators = append(generators, actor.Generator)
+		}
+	}
+	for _, generator := range generators {
+		if !v.IsNil(generator) && generator.GetID() == privateMediaCapabilityID && v.ServiceType.Match(generator.GetType()) {
+			return item
+		}
+	}
+	copy.Generator = append(generators, &v.Actor{ID: privateMediaCapabilityID, Type: v.ServiceType})
+	return &copy
+}
