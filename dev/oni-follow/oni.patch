+)
+
+type privateCapabilityStore struct {
+	storage.FullStorage
+	item v.Item
+}
+
+func (s privateCapabilityStore) Load(_ v.IRI, checks ...filters.Check) (v.Item, error) {
+	return filters.Checks(checks).Run(s.item), nil
+}
+func TestProbePrivateMediaCapability(t *testing.T) {
+	const capability = "urn:kimino:oni:private-media:1"
+	for _, tc := range []struct {
+		name                string
+		generator           v.Item
+		root, request, flag string
+		actor               bool
+		want                bool
+	}{
+		{"empty", nil, "https://bob.test/", "https://bob.test/", "1", true, true},
+		{"scalar", v.IRI("https://generator.test/"), "https://bob.test/", "https://bob.test/", "1", true, true},
+		{"array", v.ItemCollection{v.IRI("https://generator.test/one"), v.IRI("https://generator.test/two")}, "https://bob.test/", "https://bob.test/", "1", true, true},
+		{"disabled", nil, "https://bob.test/", "https://bob.test/", "", true, false},
+		{"unconfigured", nil, "", "https://bob.test/", "1", true, false},
+		{"remote", nil, "https://alice.test/", "https://bob.test/", "1", true, false},
+		{"query", nil, "https://bob.test/", "https://bob.test/?page=1", "1", true, false},
+		{"collection", nil, "https://bob.test/", "https://bob.test/outbox", "1", false, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("ONI_PROBE_LOCAL_ACTOR", tc.root)
+			t.Setenv("KIMINO_PRIVATE_MEDIA_CAPABILITY", tc.flag)
+			owner := v.Actor{ID: "https://bob.test/", Type: v.PersonType, Generator: tc.generator, To: v.ItemCollection{v.PublicNS}}
+			var item v.Item = &owner
+			if !tc.actor {
+				item = &v.OrderedCollection{ID: "https://bob.test/outbox", Type: v.OrderedCollectionType, To: v.ItemCollection{v.PublicNS}}
+			}
+			before, err := v.MarshalJSON(item)
+			if err != nil {
+				t.Fatal(err)
+			}
+			server := &oni{Control: Control{Storage: privateCapabilityStore{item: item}, Logger: lw.Nil()}, a: []v.Actor{owner}}
+			req := httptest.NewRequest("GET", tc.request, nil)
+			req.RequestURI = req.URL.RequestURI()
+			req.Header.Set("Accept", "application/activity+json")
+			req = req.WithContext(context.WithValue(req.Context(), authorizedActorCtxKey, owner))
+			recorder := httptest.NewRecorder()
+			server.ActivityPubItem(recorder, req)
+			var response map[string]any
+			if recorder.Code == 200 {
+				if err = json.Unmarshal(recorder.Body.Bytes(), &response); err != nil {
+					t.Fatal(err)
+				}
+			}
+			var generators []any
+			if list, ok := response["generator"].([]any); ok {
+				generators = list
+			} else if value := response["generator"]; value != nil {
+				generators = []any{value}
+			}
+			count := 0
+			for _, value := range generators {
+				if object, ok := value.(map[string]any); ok && object["id"] == capability && object["type"] == "Service" {
+					count++
+				}
+			}
+			if (count == 1) != tc.want || count > 1 {
+				t.Errorf("capability count=%d want=%t status=%d", count, tc.want, recorder.Code)
+			}
+			if tc.name == "scalar" {
+				if len(generators) != 2 || generators[0] != "https://generator.test/" {
+					t.Error("scalar generator not preserved")
+				}
+			}
+			if tc.name == "array" {
+				if len(generators) != 3 || generators[0] != "https://generator.test/one" || generators[1] != "https://generator.test/two" {
+					t.Error("generator array not preserved")
+				}
+			}
+			after, err := v.MarshalJSON(item)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if string(before) != string(after) {
+				t.Error("stored representation mutated")
+			}
+		})
+	}
+}
