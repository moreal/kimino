+func TestProbeProxyOwnerGate(t *testing.T) {
+	t.Setenv("ONI_PROBE_LOCAL_ACTOR", "https://bob.test/")
+	// The dev-tag HTTP client caches by URL; each run and case must reach
+	// this test transport rather than reuse a prior synthetic response.
+	runID := rand.Text()
+	owner := v.Actor{ID: "https://bob.test/", Type: v.PersonType}
+	for _, kind := range []string{"anonymous", "invalid_bearer", "invalid_cookie", "wrong_actor", "alias_actor", "empty_actor", "owner"} {
+		t.Run(kind, func(t *testing.T) {
+			transport := &proxyGateTransport{}
+			original := http.DefaultTransport
+			http.DefaultTransport = transport
+			t.Cleanup(func() { http.DefaultTransport = original })
+			server := &oni{Control: Control{Storage: proxyGateStore{}, Logger: lw.Nil()}, a: []v.Actor{owner}}
+			request := httptest.NewRequest("POST", "https://bob.test/proxyUrl", strings.NewReader(url.Values{"id": {"https://bob.test/objects/gate-" + runID + "/" + kind}}.Encode()))
+			request.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+			switch kind {
+			case "invalid_bearer":
+				request.Header.Set("Authorization", "Bearer synthetic-invalid")
+			case "invalid_cookie":
+				request.AddCookie(&http.Cookie{Name: "auth", Value: "invalid"})
+			case "wrong_actor":
+				request = request.WithContext(context.WithValue(request.Context(), authorizedActorCtxKey, v.Actor{ID: "https://alice.test/", Type: v.PersonType}))
+			case "alias_actor":
+				request = request.WithContext(context.WithValue(request.Context(), authorizedActorCtxKey, v.Actor{ID: "https://BOB.test/", Type: v.PersonType}))
+			case "empty_actor":
+				request = request.WithContext(context.WithValue(request.Context(), authorizedActorCtxKey, v.Actor{}))
+			case "owner":
+				request = request.WithContext(context.WithValue(request.Context(), authorizedActorCtxKey, owner))
+			}
+			recorder := httptest.NewRecorder()
+			server.ProxyURL().ServeHTTP(recorder, request)
+			if kind == "owner" {
+				if recorder.Code != 200 || transport.calls != 1 || !strings.Contains(recorder.Body.String(), "synthetic") {
+					t.Errorf("owner status=%d calls=%d", recorder.Code, transport.calls)
+				}
+			} else {
+				if recorder.Code != 401 && recorder.Code != 403 {
+					t.Errorf("untrusted status=%d", recorder.Code)
+				}
+				if transport.calls != 0 {
+					t.Errorf("untrusted target requests=%d", transport.calls)
+				}
+			}
+			if recorder.Header().Get("Cache-Control") != "private, no-store" {
+				t.Error("proxy response cacheable")
+			}
+			for _, header := range []string{"ETag", "Last-Modified", "Set-Cookie"} {
+				if recorder.Header().Get(header) != "" {
+					t.Errorf("unsafe upstream header %s retained", header)
+				}
+			}
+		})
+	}
+}
