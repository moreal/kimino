+func TestProbePrivateDynamicResponseNoStore(t *testing.T) {
+	for _, typ := range []v.ActivityVocabularyType{v.NoteType, v.CreateType, v.OrderedCollectionType, v.ImageType, v.TombstoneType} {
+		for _, auth := range []string{"none", "Authorization", "Cookie", "Signature", "Signature-Input"} {
+			for _, method := range []string{http.MethodGet, http.MethodHead} {
+				t.Run(string(typ)+"/"+auth+"/"+method, func(t *testing.T) {
+					stamp := time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)
+					req := httptest.NewRequest(method, "https://alice.test/objects/synthetic", nil)
+					if auth != "none" {
+						req.Header.Set(auth, "synthetic-test-value")
+					}
+					req.Header.Set("If-None-Match", `"test-etag"`)
+					req.Header.Set("If-Modified-Since", stamp.Format(time.RFC1123))
+					w := httptest.NewRecorder()
+					w.Header().Set("ETag", `"stale"`)
+					w.Header().Set("Last-Modified", stamp.Format(time.RFC1123))
+					writeResponse([]byte("synthetic"), typ, stamp, "application/activity+json", `"test-etag"`).ServeHTTP(w, req)
+					want := http.StatusOK
+					if typ == v.TombstoneType {
+						want = http.StatusGone
+					}
+					if w.Code != want {
+						t.Errorf("status=%d want=%d", w.Code, want)
+					}
+					if w.Header().Get("Cache-Control") != "private, no-store" {
+						t.Error("dynamic response is cacheable")
+					}
+					if w.Header().Get("ETag") != "" || w.Header().Get("Last-Modified") != "" {
+						t.Error("private validator retained")
+					}
+					if method == http.MethodHead && w.Body.Len() != 0 {
+						t.Error("HEAD returned body")
+					}
+					if method == http.MethodGet && w.Body.String() != "synthetic" {
+						t.Error("GET response body missing")
+					}
+				})
+			}
+		}
+	}
+}
