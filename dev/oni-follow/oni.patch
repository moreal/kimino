+					}
+					seen[id] = true
+					if id == items[31].GetLink() {
+						private = true
+					}
+					if tc.query == "?maxItems=20&type=Create" && it.GetType() != vocab.CreateType {
+						t.Fatal("content filter lost")
+					}
