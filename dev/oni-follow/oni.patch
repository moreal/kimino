+package oni
+
+import (
+	vocab "github.com/go-ap/activitypub"
+	"github.com/go-ap/filters"
+)
+
+func collectionAuthorizationChecks(collection, requested, actorID vocab.IRI) filters.Checks {
+	if isOwnCollectionRequest(collection, requested) {
+		return nil
+	}
+	return filters.Checks{filters.Authorized(actorID)}
+}
+
+// isOwnCollectionRequest compares resource identity independently of page and
+// filter queries. It must not normalize a different origin or path into an
+// ownership grant, or modify the IRI later used to load the requested page.
+func isOwnCollectionRequest(collection, requested vocab.IRI) bool {
+	owner, err := collection.URL()
+	if err != nil || owner == nil {
+		return false
+	}
+	page, err := requested.URL()
+	if err != nil || page == nil {
+		return false
+	}
+	if (owner.Scheme != "https" && owner.Scheme != "http") || owner.Host == "" || owner.Opaque != "" || owner.User != nil || owner.Fragment != "" || owner.RawQuery != "" || owner.ForceQuery {
+		return false
+	}
+	if page.Opaque != "" || page.User != nil || page.Fragment != "" {
+		return false
+	}
+	return owner.Scheme == page.Scheme && owner.Host == page.Host && owner.EscapedPath() == page.EscapedPath()
+}
