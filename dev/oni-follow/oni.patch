+type rasterProxyTransport struct {
+	accept             string
+	calls              int
+	responseType, body string
+}
+
+func (c *rasterProxyTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	c.accept = strings.Join(r.Header.Values("Accept"), ",")
+	c.calls++
+	if c.responseType == "negotiate" {
+		contentType, body := "application/activity+json", "synthetic metadata"
+		if c.accept == "image/png" {
+			contentType, body = "image/png", "\x00\xffsynthetic binary"
+		}
+		return &http.Response{StatusCode: 200, Status: "200 OK", Header: http.Header{"Content-Type": {contentType}, "Cache-Control": {"private, no-store"}, "Vary": {"Accept"}}, Body: io.NopCloser(strings.NewReader(body)), Request: r}, nil
+	}
+	return &http.Response{StatusCode: 200, Status: "200 OK", Header: http.Header{"Content-Type": strings.Split(c.responseType, "\n"), "Cache-Control": {"private, no-store"}}, Body: io.NopCloser(strings.NewReader(c.body)), Request: r}, nil
+}
