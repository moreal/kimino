+package oni
+
+import (
+	vocab "github.com/go-ap/activitypub"
+	"github.com/go-ap/errors"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+)
+
+// Probe-only: TLS terminates at the isolated gateway. Use its explicitly configured
+// owned origin, never a caller-supplied forwarded scheme, for collection identity.
+// The request used by signature validation remains unchanged.
+func canonicalProbeReceivedIn(receivedIn vocab.IRI, r *http.Request) (vocab.IRI, error) {
+	configured := os.Getenv("ONI_PROBE_LOCAL_ACTOR")
+	if configured == "" {
+		return receivedIn, nil
+	}
+	origin, err := url.Parse(configured)
+	if err != nil || origin.Scheme != "https" || origin.Host == "" || origin.User != nil || (origin.Path != "" && origin.Path != "/") || origin.RawQuery != "" || origin.Fragment != "" {
+		return "", errors.BadRequestf("invalid configured probe origin")
+	}
+	if r == nil || r.URL == nil || !strings.EqualFold(r.Host, origin.Host) {
+		return "", errors.BadRequestf("request host differs from configured probe origin")
+	}
+	canonical := *r.URL
+	canonical.Scheme = origin.Scheme
+	canonical.Host = origin.Host
+	canonical.User = nil
+	canonical.Opaque = ""
+	canonical.Fragment = ""
+	canonical.RawFragment = ""
+	return vocab.IRI(canonical.String()), nil
+}
