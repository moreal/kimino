+func exactResourceURL(iri v.IRI) (*url.URL, bool) {
+	u, err := iri.URL()
+	return u, err == nil && u != nil && (u.Scheme == "https" || u.Scheme == "http") && u.Host != "" && u.User == nil && u.Opaque == "" && u.RawQuery == "" && !u.ForceQuery && u.Fragment == ""
+}
+
+// Complete unfiltered membership is required, including negative block evidence.
+// SetupCtl pins both storage caching and indexing off for these reads.
+func (o *oni) completeLocalMembers(iri v.IRI) (map[v.IRI]bool, bool) {
+	item, err := o.Storage.Load(iri)
+	if err != nil || v.IsNil(item) || item.GetLink() != iri || (item.GetType() != v.CollectionType && item.GetType() != v.OrderedCollectionType) {
+		return nil, false
+	}
+	members := map[v.IRI]bool{}
+	valid := false
+	if err = v.OnCollection(item, func(c *v.Collection) error {
+		if !v.IsNil(c.First) || !v.IsNil(c.Last) || !v.IsNil(c.Current) || len(c.Items) > 10000 {
+			return nil
+		}
+		for _, member := range c.Items {
+			if v.IsNil(member) || (!v.IsIRI(member) && !v.ActorTypes.Match(member.GetType())) {
+				return nil
+			}
+			id := member.GetLink()
+			if _, ok := exactResourceURL(id); !ok || members[id] {
+				return nil
+			}
+			members[id] = true
+		}
+		valid = uint(len(members)) == c.TotalItems
+		return nil
+	}); err != nil {
+		return nil, false
+	}
+	return members, valid
+}
+
+// This adds only local Note/Image access. It never expands an arbitrary remote
+// audience, collection response, embedded resource, or caller-supplied owner.
+func (o *oni) loadLocalFollowerResource(requested v.IRI, requester v.IRI) (v.Item, bool) {
+	if requester == "" || requester == auth.AnonymousActor.ID {
+		return nil, false
+	}
+	if _, ok := exactResourceURL(requester); !ok {
+		return nil, false
+	}
+	owner := v.IRI(os.Getenv("ONI_PROBE_LOCAL_ACTOR"))
+	ownerURL, ok := exactResourceURL(owner)
+	if !ok || ownerURL.Path != "/" {
+		return nil, false
+	}
+	resourceURL, ok := exactResourceURL(requested)
+	if !ok || resourceURL.Scheme != ownerURL.Scheme || resourceURL.Host != ownerURL.Host || v.ValidCollectionIRI(requested) {
+		return nil, false
+	}
+	item, err := o.Storage.Load(requested)
+	if err != nil || v.IsNil(item) || item.GetLink() != requested || (item.GetType() != v.NoteType && item.GetType() != v.ImageType) {
+		return nil, false
+	}
+	followers := v.Followers.IRI(owner)
+	addressed := false
+	if err = v.OnObject(item, func(ob *v.Object) error {
+		if v.IsNil(ob.AttributedTo) || v.IsItemCollection(ob.AttributedTo) || ob.AttributedTo.GetLink() != owner {
+			return nil
+		}
+		for _, recipient := range ob.Recipients() {
+			if !v.IsNil(recipient) && recipient.GetLink() == followers {
+				addressed = true
+			}
+		}
+		return nil
+	}); err != nil || !addressed {
+		return nil, false
+	}
+	following, complete := o.completeLocalMembers(followers)
+	if !complete || !following[requester] {
+		return nil, false
+	}
+	blocked, complete := o.completeLocalMembers(processing.BlockedCollection.IRI(owner))
+	if !complete || blocked[requester] {
+		return nil, false
+	}
+	return projectFollowerResource(item)
+}
+
+// The grant covers only this resource, never objects embedded or expanded by
+// storage. Every nested resource requires its own authorization on dereference.
+func projectFollowerResource(item v.Item) (v.Item, bool) {
+	var projected *v.Object
+	valid := true
+	err := v.OnObject(item, func(original *v.Object) error {
+		copy := *original
+		fields := []*v.Item{&copy.Attachment, &copy.AttributedTo, &copy.Context, &copy.Generator, &copy.Icon, &copy.Image, &copy.InReplyTo, &copy.Location, &copy.Preview, &copy.Replies, &copy.URL, &copy.Likes, &copy.Shares}
+		for _, field := range fields {
+			var ok bool
+			*field, ok = followerReference(*field, 0)
+			if !ok {
+				valid = false
+				return nil
+			}
+		}
+		collections := []*v.ItemCollection{&copy.Audience, &copy.Tag, &copy.To, &copy.Bto, &copy.CC, &copy.BCC}
+		for _, field := range collections {
+			if len(*field) == 0 {
+				continue
+			}
+			refs, ok := followerReference(*field, 0)
+			if !ok {
+				valid = false
+				return nil
+			}
+			*field = refs.(v.ItemCollection)
+		}
+		projected = &copy
+		return nil
+	})
+	return projected, err == nil && valid && projected != nil
+}
+
+func followerReference(item v.Item, depth int) (v.Item, bool) {
+	if v.IsNil(item) {
+		return nil, true
+	}
+	if depth > 4 {
+		return nil, false
+	}
+	if v.IsItemCollection(item) {
+		var result v.ItemCollection
+		valid := true
+		err := v.OnItemCollection(item, func(items *v.ItemCollection) error {
+			if len(*items) > 10000 {
+				valid = false
+				return nil
+			}
+			result = make(v.ItemCollection, 0, len(*items))
+			for _, child := range *items {
+				ref, ok := followerReference(child, depth+1)
+				if !ok {
+					valid = false
+					return nil
+				}
+				if !v.IsNil(ref) {
+					result = append(result, ref)
+				}
+			}
+			return nil
+		})
+		return result, err == nil && valid
+	}
+	if id := item.GetID(); id != "" {
+		if _, ok := exactResourceURL(id); !ok {
+			return nil, false
+		}
+		return v.IRI(id), true
+	}
+	// An inline Mention/Link has no separately addressable identity. Preserve only
+	// its addressing semantics, never copied name/preview/media metadata.
+	if v.LinkTypes.Match(item.GetType()) {
+		link, err := v.ToLink(item)
+		if err != nil || link == nil {
+			return nil, false
+		}
+		if _, ok := exactResourceURL(link.Href); !ok {
+			return nil, false
+		}
+		return &v.Link{Type: link.Type, Href: link.Href}, true
+	}
+	return nil, false
+}
