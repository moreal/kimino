+package oni
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+	"time"
+)
+
+const proxyBodyLimit int64 = 5 * 1024 * 1024
+const proxyRequestTimeout = 10 * time.Second
+
+// Buffer every upstream status before the ActivityPub client's signature retry
+// code can drain it. No retry or downstream response receives an unbounded body.
+type boundedProxyTransport struct{ base http.RoundTripper }
+
+func (t boundedProxyTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.Context().Err() != nil {
+		return nil, errors.New("proxy request expired")
+	}
+	res, err := t.base.RoundTrip(req)
+	if err != nil {
+		return nil, errors.New("proxy upstream request failed")
+	}
+	if res == nil || res.Body == nil {
+		return nil, errors.New("proxy upstream response missing")
+	}
+	defer res.Body.Close()
+	if res.ContentLength > proxyBodyLimit {
+		return nil, errors.New("proxy upstream response too large")
+	}
+	data, err := io.ReadAll(io.LimitReader(res.Body, proxyBodyLimit+1))
+	if err != nil || req.Context().Err() != nil {
+		return nil, errors.New("proxy upstream response interrupted")
+	}
+	if int64(len(data)) > proxyBodyLimit {
+		return nil, errors.New("proxy upstream response too large")
+	}
+	res.Body = io.NopCloser(bytes.NewReader(data))
+	res.ContentLength = int64(len(data))
+	res.Header.Set("Content-Length", strconv.Itoa(len(data)))
+	return res, nil
+}
+func rejectProxyRedirect(_ *http.Request, _ []*http.Request) error {
+	return errors.New("proxy redirects are not permitted")
+}
