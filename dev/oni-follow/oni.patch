+func TestOwnCollectionFollowersAddressedPage(t *testing.T) {
+	const alice vocab.IRI = "https://alice.test:18448/"
+	const own vocab.IRI = "https://alice.test:18448/inbox"
+	note := &vocab.Activity{ID: "https://bob.test:18448/activities/1", Type: vocab.CreateType, Actor: vocab.IRI("https://bob.test:18448/"), To: vocab.ItemCollection{vocab.IRI("https://bob.test:18448/followers")}, Object: &vocab.Object{ID: "https://bob.test:18448/notes/1", Type: vocab.NoteType}}
+	if filters.Authorized(alice).Match(note) {
+		t.Fatal("fixture must demonstrate collection-addressed recipient exclusion")
+	}
+	for _, request := range []vocab.IRI{own, own + "?maxItems=20", own + "?maxItems=20&after=cursor"} {
+		checks := filters.Checks{}
+		if !isOwnCollectionRequest(own, request) {
+			checks = append(checks, filters.Authorized(alice))
+		}
+		if !filters.All(checks...).Match(note) {
+			t.Fatal("owner page lost a server-delivered followers-addressed activity")
+		}
+	}
+	for _, visitor := range []vocab.IRI{"", "https://charlie.test:18448/"} {
+		collection := vocab.IRI("")
+		if visitor != "" {
+			collection = visitor + "inbox"
+		}
+		if isOwnCollectionRequest(collection, own+"?maxItems=20") {
+			t.Fatal("visitor treated as owner")
+		}
+		if filters.Authorized(visitor).Match(note) {
+			t.Fatal("visitor gained collection-addressed access")
+		}
+	}
+}
