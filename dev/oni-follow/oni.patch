+}
+
+func (b *proxyCountBody) Read(p []byte) (int, error) {
+	n, e := b.Reader.Read(p)
+	b.bytes += n
+	return n, e
+}
+func (b *proxyCountBody) Close() error { b.closed = true; return nil }
+
+type proxyStallBody struct {
+	ctx    context.Context
+	closed bool
+}
+
+func (b *proxyStallBody) Read([]byte) (int, error) { <-b.ctx.Done(); return 0, b.ctx.Err() }
+func (b *proxyStallBody) Close() error             { b.closed = true; return nil }
+
+func TestProbeProxyTransportBounds(t *testing.T) {
+	t.Setenv("ONI_PROBE_LOCAL_ACTOR", "https://bob.test/")
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	owner := v.Actor{ID: "https://bob.test/", Type: v.PersonType, PublicKey: v.PublicKey{ID: "https://bob.test/#main-key", Owner: "https://bob.test/"}}
+	for _, scenario := range []string{"redirect", "error_oversize", "raster_oversize", "stalled_body", "valid_png"} {
+		t.Run(scenario, func(t *testing.T) {
+			calls, secondHits := 0, 0
+			firstSigned := false
+			var counted *proxyCountBody
+			var stalled *proxyStallBody
+			transport := proxyRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+				calls++
+				if calls == 1 {
+					firstSigned = r.Header.Get("Signature") != "" || r.Header.Get("Signature-Input") != ""
+				}
+				if r.URL.Host == "second.test" {
+					secondHits++
+				}
+				status := 200
+				headers := http.Header{"Content-Type": {"image/png"}, "Cache-Control": {"private, no-store"}}
+				var body io.ReadCloser = io.NopCloser(strings.NewReader("\x89PNG\r\n\x1a\nsynthetic"))
+				switch scenario {
+				case "redirect":
+					if r.URL.Host == "first.test" {
+						status = 302
+						headers.Set("Location", "https://second.test/same-path")
+						body = io.NopCloser(strings.NewReader("redirect"))
+					}
+				case "error_oversize", "raster_oversize":
+					if scenario == "error_oversize" {
+						status = 403
+					}
+					counted = &proxyCountBody{Reader: strings.NewReader(strings.Repeat("X", 5*1024*1024+100))}
+					body = counted
+				case "stalled_body":
+					stalled = &proxyStallBody{ctx: r.Context()}
+					body = stalled
+				case "valid_png":
+					deadline, ok := r.Context().Deadline()
+					if !ok || time.Until(deadline) > 11*time.Second {
+						t.Error("proxy request has no bounded total deadline")
+					}
+				}
+				return &http.Response{StatusCode: status, Header: headers, Body: body, ContentLength: -1, Request: r}, nil
+			})
+			prior := http.DefaultTransport
+			http.DefaultTransport = transport
+			t.Cleanup(func() { http.DefaultTransport = prior })
+			server := &oni{Control: Control{Storage: boundedProxyTestStore{key: key}, Logger: lw.Nil()}, a: []v.Actor{owner}}
+			req := httptest.NewRequest("POST", "https://bob.test/proxyUrl", strings.NewReader(url.Values{"id": {"https://first.test/same-path?case=" + scenario + "&run=" + rand.Text()}}.Encode()))
+			req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+			req.Header.Set("Accept", "image/png")
+			req = req.WithContext(context.WithValue(req.Context(), authorizedActorCtxKey, owner))
+			if scenario == "stalled_body" {
+				ctx, cancel := context.WithTimeout(req.Context(), 30*time.Millisecond)
+				defer cancel()
+				req = req.WithContext(ctx)
+			}
+			w := httptest.NewRecorder()
+			server.ProxyURL().ServeHTTP(w, req)
+			if !firstSigned {
+				t.Error("proxy request lost owner signing")
+			}
+			if scenario == "valid_png" {
+				if w.Code != 200 || w.Body.String() != "\x89PNG\r\n\x1a\nsynthetic" {
+					t.Error("valid raster representation changed")
+				}
+			} else if w.Code != 502 || w.Body.Len() > 1024 {
+				t.Errorf("failed proxy status=%d responseBytes=%d", w.Code, w.Body.Len())
+			}
+			if calls != 1 || secondHits != 0 {
+				t.Errorf("target requests=%d redirectedRequests=%d", calls, secondHits)
+			}
+			if counted != nil && (counted.bytes > 5*1024*1024+1 || !counted.closed) {
+				t.Errorf("upstream bytes=%d closed=%t", counted.bytes, counted.closed)
+			}
+			if stalled != nil && !stalled.closed {
+				t.Error("stalled body not closed")
+			}
+			if w.Header().Get("Cache-Control") != "private, no-store" {
+				t.Error("proxy response cacheable")
+			}
+		})
+	}
+}
+
+func TestProbeProxyBodyLimitEdges(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		size     int
+		declared int64
+		allow    bool
+	}{{"at_limit", 5 * 1024 * 1024, -1, true}, {"one_over", 5*1024*1024 + 1, -1, false}, {"advertised_over", 1, 5*1024*1024 + 1, false}} {
+		t.Run(tc.name, func(t *testing.T) {
+			body := &proxyCountBody{Reader: strings.NewReader(strings.Repeat("X", tc.size))}
+			transport := boundedProxyTransport{base: proxyRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+				return &http.Response{StatusCode: 200, Header: make(http.Header), ContentLength: tc.declared, Body: body, Request: r}, nil
+			})}
+			request := httptest.NewRequest("GET", "https://first.test/resource", nil)
+			response, err := transport.RoundTrip(request)
+			if tc.allow {
+				if err != nil {
+					t.Fatal("in-limit response rejected")
+				}
+				defer response.Body.Close()
+				data, readErr := io.ReadAll(response.Body)
+				if readErr != nil || len(data) != tc.size {
+					t.Fatal("in-limit body changed")
+				}
+			} else if err == nil {
+				response.Body.Close()
+				t.Fatal("oversize accepted")
+			}
+			if !body.closed {
+				t.Error("upstream body not closed")
+			}
+			if tc.declared > proxyBodyLimit && body.bytes != 0 {
+				t.Error("advertised oversized body was read")
+			}
+		})
+	}
+}
+
+func TestProbeProxyTransportDoesNotMutateDefaultTLS(t *testing.T) {
+	original := http.DefaultTransport
+	base := &http.Transport{TLSClientConfig: &tls.Config{InsecureSkipVerify: false}}
+	http.DefaultTransport = base
+	t.Cleanup(func() { http.DefaultTransport = original; base.CloseIdleConnections() })
+	control := Control{Storage: proxyGateStore{}, Logger: lw.Nil()}
+	control.proxyClient(v.Actor{ID: "https://bob.test/", Type: v.PersonType}, lw.Ctx{})
+	if base.TLSClientConfig.InsecureSkipVerify {
+		t.Fatal("proxy constructor changed global TLS verification")
+	}
+}
