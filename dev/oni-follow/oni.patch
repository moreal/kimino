+package oni
+
+import (
+	vocab "github.com/go-ap/activitypub"
+	"github.com/go-ap/processing"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestProbeReceivedIn(t *testing.T) {
+	const origin = "https://alice.test:18446/"
+	t.Setenv("ONI_PROBE_LOCAL_ACTOR", origin)
+	t.Run("TLS_terminated_inbox_stays_local", func(t *testing.T) {
+		r := httptest.NewRequest("POST", "http://alice.test:18446/inbox", nil)
+		got, err := canonicalProbeReceivedIn("http://alice.test:18446/inbox", r)
+		if err != nil {
+			t.Fatal(err)
+		}
+		p := processing.New(processing.WithLocalIRIChecker(func(iri vocab.IRI) bool {
+			u, err := iri.URL()
+			return err == nil && u.Scheme == "https" && u.Host == "alice.test:18446"
+		}))
+		act := &vocab.Activity{Type: vocab.CreateType, Actor: vocab.IRI("https://bob.test:18446/"), To: vocab.ItemCollection{vocab.PublicNS}, CC: vocab.ItemCollection{vocab.IRI("https://bob.test:18446/followers")}}
+		recipients := p.BuildInboxRecipientsList(act, got)
+		local := 0
+		for _, rec := range recipients {
+			if p.IsLocal(rec) {
+				local++
+			}
+		}
+		if local != 1 {
+			t.Fatalf("local recipient count=%d", local)
+		}
+	})
+	t.Run("path_query_and_request_unchanged", func(t *testing.T) {
+		r := httptest.NewRequest("POST", "http://alice.test:18446/inbox%2Fpart?x=1&x=2", nil)
+		before := r.URL.String()
+		got, err := canonicalProbeReceivedIn(vocab.IRI(before), r)
+		if err != nil || got != "https://alice.test:18446/inbox%2Fpart?x=1&x=2" {
+			t.Fatalf("canonical path/query incorrect: error=%t", err != nil)
+		}
+		if r.URL.String() != before || r.TLS != nil {
+			t.Fatal("request mutated")
+		}
+	})
+	t.Run("reject_host_mismatch", func(t *testing.T) {
+		r := httptest.NewRequest("POST", "http://other.test:18446/inbox", nil)
+		if _, err := canonicalProbeReceivedIn("http://other.test:18446/inbox", r); err == nil {
+			t.Fatal("mismatched host accepted")
+		}
+	})
+	t.Run("unconfigured_unchanged", func(t *testing.T) {
+		t.Setenv("ONI_PROBE_LOCAL_ACTOR", "")
+		r := httptest.NewRequest("POST", "http://other.test/inbox", nil)
+		got, err := canonicalProbeReceivedIn("http://other.test/inbox", r)
+		if err != nil || got != "http://other.test/inbox" {
+			t.Fatal("unconfigured behavior changed")
+		}
+	})
+}
