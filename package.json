{
  "name": "kimino",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:design-system": "vite --host 127.0.0.1 --open /design-system.html",
    "build:design-system": "vite build --mode design-system",
    "test:design-system": "playwright test tests/design-system.spec.ts tests/visual-language.spec.ts",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run changelog:check",
    "changelog:check": "sacho check",
    "changelog:build": "sacho sync",
    "c2s:up": "docker compose up -d",
    "c2s:seed": "python3 scripts/c2s-seed.py",
    "c2s:smoke": "python3 scripts/c2s-smoke.py",
    "c2s:down": "docker compose down",
    "test:e2e:ui": "playwright test tests/ui.spec.ts tests/product.spec.ts tests/interface-quality.spec.ts tests/form-feedback.spec.ts tests/reading-controls.spec.ts tests/image-authoring.spec.ts tests/relationships.spec.ts tests/history.spec.ts tests/relationship-history.spec.ts tests/reply-audience.spec.ts tests/private-image-reading.spec.ts tests/design-system.spec.ts tests/visual-language.spec.ts",
    "format": "prettier --write src tests *.ts *.json index.html design-system.html",
    "format:check": "prettier --check src tests *.ts *.json index.html design-system.html",
    "c2s:follow:build": "python3 scripts/c2s-follow-fixture.py build",
    "c2s:follow:up": "python3 scripts/c2s-follow-fixture.py up",
    "c2s:follow:down": "python3 scripts/c2s-follow-fixture.py down",
    "c2s:follow:seed": "python3 scripts/c2s-follow-fixture.py seed",
    "test:e2e:follow": "KIMINO_FOLLOW_FIXTURE_DIR=${KIMINO_FOLLOW_FIXTURE_DIR:-.local/c2s-follow} KIMINO_FOLLOW_PORT=${KIMINO_FOLLOW_PORT:-18448} playwright test tests/follow-c2s.spec.ts"
  },
  "dependencies": {
    "@logtape/logtape": "^2.1.0",
    "@solidjs/web": "2.0.0-rc.6",
    "dompurify": "^3.3.0",
    "solid-js": "2.0.0-rc.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sacho/sacho": "^0.1.0",
    "@solidjs/vite-plugin": "3.0.0-next.39",
    "@types/node": "^24.0.0",
    "prettier": "3.8.3",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.0"
}
